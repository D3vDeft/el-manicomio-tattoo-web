# Cache-Control headers
/*
  Cache-Control: public, max-age=3600, must-revalidate
  
  # Security headers
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  
  # CSP header for XSS protection
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com https://api.github.com; frame-ancestors 'self';
  
  # Performance headers
  Accept-Encoding: gzip, deflate, br
  Vary: Accept-Encoding

# Longer cache for static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static SVG/images
/og-image.svg
  Cache-Control: public, max-age=604800
  Content-Type: image/svg+xml

# Sitemap and robots
/sitemap.xml
  Cache-Control: public, max-age=604800
  Content-Type: application/xml

/robots.txt
  Cache-Control: public, max-age=604800
  Content-Type: text/plain

# Schema.json
/schema.json
  Cache-Control: public, max-age=604800
  Content-Type: application/json